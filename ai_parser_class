import os
import yaml

class ResumeParser:
    def __init__(self, resume_file=None, job_file=None):
        self.resume_file = resume_file
        self.job_file = job_file
        self.resume = {}
        self.keywords = []

        if resume_file:
            self.load_resume(resume_file)
        if job_file:
            self.load_keywords(job_file)

    def load_resume(self, resume_file=None):
        """Load or reload the resume YAML file."""
        if resume_file:
            self.resume_file = resume_file
        if not self.resume_file:
            raise ValueError("No resume file specified")

        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dataDir", self.resume_file)
        with open(path, 'r', encoding='utf-8') as file:
            self.resume = yaml.safe_load(file)

        return self.resume

    def load_keywords(self, job_file=None):
        """Load or reload the job description keywords."""
        if job_file:
            self.job_file = job_file
        if not self.job_file:
            raise ValueError("No job description file specified")

        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dataDir", self.job_file)
        keywords = []
        with open(path, 'r') as file:
            for line in file:
                if line.strip() and not line.strip().startswith('///'):
                    keywords.append(line.strip())
        self.keywords = keywords
        return self.keywords

    def get_section(self, section_name):
        """Return a specific section from the resume."""
        return self.resume.get(section_name, {})

    def update_section(self, section_name, data):
        """Update a specific section of the resume."""
        self.resume[section_name] = data

    def reload(self):
        """Reload both resume and keywords."""
        if self.resume_file:
            self.load_resume(self.resume_file)
        if self.job_file:
            self.load_keywords(self.job_file)
